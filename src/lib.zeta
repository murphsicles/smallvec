 if is_zst { debug_assert!(! on_heap); TaggedLen(len) } else { debug_assert!(len < isize::MAX as usize); TaggedLen((len << 1) | on_heap as usize) }
 }
 
 pub fn on_heap(self, is_zst: bool) -> bool {
 if is_zst { false } else { (self.0 &1_usize) == 1 }
 }
 
 pub fn value(self, is_zst: bool) -> usize {
 if is_zst { self.0 } else { self.0>> 1 }
 }
 
}

